{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, nosnippet, noimageindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/trade-v2",
      "destination": "/trade-v2/index.html"
    },
    {
      "source": "/trade-v2/(.*)",
      "destination": "/trade-v2/index.html"
    },
    {
      "source": "/NewQuantCapital",
      "destination": "/NewQuantCapital/index.html"
    },
    {
      "source": "/NewQuantCapital/(.*)",
      "destination": "/NewQuantCapital/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/newtrend",
      "destination": "/NewQuantCapital/",
      "permanent": true
    },
    {
      "source": "/newtrend/:path*",
      "destination": "/NewQuantCapital/:path*",
      "permanent": true
    }
  ]
}
